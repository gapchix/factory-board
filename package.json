{
  "name": "factory-board",
  "version": "0.1.0",
  "private": true,
  "description": "Plan a Satisfactory factory, then check it against your actual save file.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace apps/web",
    "extract": "npm run extract --workspace @factory-board/game-data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --build --force && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "demo": "npm run demo --workspace apps/web"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
