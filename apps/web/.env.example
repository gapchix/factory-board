# Which save the dashboard opens with. Both are optional — with neither set the
# newest save in the usual SaveGames folder is used.
#
# One exact file:
# SATISFACTORY_SAVE=C:/Users/you/AppData/Local/FactoryGame/Saved/SaveGames/7656.../polska.sav
#
# Or a folder, where the most recently written .sav wins (handy with autosaves):
# SATISFACTORY_SAVES_DIR=C:/Users/you/AppData/Local/FactoryGame/Saved/SaveGames/7656...

# Where Satisfactory is installed, if `npm run extract` cannot find it.
# SATISFACTORY_DIR=D:/Games/Satisfactory
